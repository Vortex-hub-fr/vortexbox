[Unit]
Description=VortexBox Node.js Service
After=network.target

[Service]
Type=simple
User=vortexbox
Group=vortexbox
WorkingDirectory=/opt/vortexbox
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
EnvironmentFile=-/opt/vortexbox/.env
ExecStart=/usr/bin/node /opt/vortexbox/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

