# Serveur web
HOST=0.0.0.0
PORT=8080

# Admin (obligatoire au démarrage)
ADMIN_EMAIL=vortexcore@outlook.fr
# Recommandé: hash scrypt au format scrypt$<saltBase64>$<hashBase64>
ADMIN_PASSWORD_HASH=
# Fallback (moins sûr) si hash non fourni:
ADMIN_PASSWORD=

# Email auth VortexBox
# Option A: Resend (laisser vide si vous utilisez SMTP)
RESEND_API_KEY=remplacer_par_votre_cle_resend

# Option B: SMTP Outlook
MAIL_FROM=VortexBox <votre_email@outlook.fr>
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=votre_email@outlook.fr
SMTP_PASS=mot_de_passe_ou_app_password

# IA VortexBot (optionnel: fallback intelligent si vide)
OPENAI_API_KEY=remplacer_par_votre_cle_openai
OPENAI_MODEL=gpt-4.1-mini

# IA gratuite (prioritaire si active)
AI_FREE_FIRST=1
HF_API_KEY=remplacer_par_votre_cle_huggingface
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Rétention stockage (jours)
BACKUPS_RETENTION_DAYS=90
CONTENT_BACKUPS_RETENTION_DAYS=30
BACKUPS_KEEP_MIN_FILES=8
CONTENT_BACKUPS_KEEP_MIN_FILES=30

# Origines web autorisees en production (separees par des virgules)
TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com
