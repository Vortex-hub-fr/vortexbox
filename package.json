{
  "name": "vortexbox-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site VortexBox",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check:syntax": "node --check server.js && node --check script.js && node --check faq.js && node --check about.js",
    "check:inline-handlers": "node tools/check-inline-handlers.js",
    "check:smoke": "npm run check:syntax && npm run check:inline-handlers",
    "cleanup:uploads:report": "node tools/cleanup-unused-uploads.js",
    "cleanup:uploads:quarantine": "node tools/cleanup-unused-uploads.js --quarantine --yes",
    "cleanup:uploads:delete": "node tools/cleanup-unused-uploads.js --delete --yes",
    "video:2k:about": "node tools/upscale-videos-local.js --active-about --target=2k",
    "video:2k:build": "node tools/upscale-videos-local.js --all-machine --target=2k",
    "video:2k:file": "node tools/upscale-videos-local.js --target=2k",
    "video:uhd:about": "node tools/upscale-videos-local.js --active-about",
    "video:uhd:build": "node tools/upscale-videos-local.js --all-machine",
    "video:uhd:file": "node tools/upscale-videos-local.js"
  }
}
